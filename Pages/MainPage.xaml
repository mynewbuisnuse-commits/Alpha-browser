<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlphaBrowser.Pages.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid x:Name="RootGrid" RowDefinitions="40,2,52,Auto,*">

        <!-- Row 0: Unified Title Bar + Tab Strip -->
        <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="Auto,*,Auto" Padding="8,0,4,0">
            <!-- Brand -->
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 4" StrokeThickness="0" BackgroundColor="#7C5CFF"
                        WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                <Label Text="Alpha" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Tab strip -->
            <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        VerticalOptions="Center" Margin="4,0">
                <HorizontalStackLayout x:Name="TabStrip" Spacing="2"/>
            </ScrollView>

            <!-- Traffic-light buttons (visual only on mobile) -->
            <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                <Ellipse Fill="#FF5F57" WidthRequest="14" HeightRequest="14"/>
                <Ellipse Fill="#FFBD2E" WidthRequest="14" HeightRequest="14"/>
                <Ellipse Fill="#28C940" WidthRequest="14" HeightRequest="14"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Row 1: Accent hairline -->
        <BoxView Grid.Row="1" HeightRequest="2" Color="#7C5CFF" VerticalOptions="Fill"/>

        <!-- Row 2: Toolbar -->
        <Grid Grid.Row="2" x:Name="Toolbar" ColumnDefinitions="Auto,*,Auto" Padding="4,4" ColumnSpacing="4">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="1"
                    BackgroundColor="{StaticResource BgElevated}" Padding="4,0" Stroke="{StaticResource BorderColor}">
                <HorizontalStackLayout Spacing="1">
                    <Button x:Name="BackBtn" Text="&#x25C0;" FontSize="14" WidthRequest="34" HeightRequest="34"
                            BackgroundColor="Transparent" Clicked="OnBack" CornerRadius="17"/>
                    <Button x:Name="FwdBtn" Text="&#x25B6;" FontSize="14" WidthRequest="34" HeightRequest="34"
                            BackgroundColor="Transparent" Clicked="OnForward" CornerRadius="17"/>
                    <Button x:Name="ReloadBtn" Text="&#x21BB;" FontSize="16" WidthRequest="34" HeightRequest="34"
                            BackgroundColor="Transparent" Clicked="OnReload" CornerRadius="17"/>
                    <Button x:Name="HomeBtn" Text="&#x2302;" FontSize="16" WidthRequest="34" HeightRequest="34"
                            BackgroundColor="Transparent" Clicked="OnHome" CornerRadius="17"/>
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="1"
                    BackgroundColor="{StaticResource BgElevated}" Stroke="{StaticResource BorderColor}"
                    VerticalOptions="Center">
                <Entry x:Name="AddressBar" Placeholder="Search Google or enter URL"
                       FontSize="13" VerticalOptions="Center" HeightRequest="36" Margin="12,0"
                       BackgroundColor="Transparent" Keyboard="Url" ReturnType="Go"
                       Completed="OnAddressGo" TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextMuted}"/>
            </Border>

            <HorizontalStackLayout Grid.Column="2" Spacing="2">
                <Button x:Name="MenuBtn" Text="&#x2630;" FontSize="16" WidthRequest="38" HeightRequest="38"
                        BackgroundColor="Transparent" Clicked="OnMenu" CornerRadius="19"
                        TextColor="{StaticResource TextPrimary}"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Row 3: Pinned apps bar (auto-hide when empty) -->
        <ScrollView Grid.Row="3" x:Name="PinnedBar" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never" HeightRequest="36" IsVisible="False">
            <HorizontalStackLayout x:Name="PinnedAppsPanel" Spacing="8" Padding="12,0"/>
        </ScrollView>

        <!-- Row 4: Content -->
        <Grid Grid.Row="4" x:Name="ContentArea">
            <Grid x:Name="WebViewArea" IsVisible="False"/>

            <!-- Start Page -->
            <Grid x:Name="StartPage" IsVisible="True" Padding="20" RowDefinitions="Auto,*,Auto">
                <VerticalStackLayout Grid.Row="0" HorizontalOptions="End" VerticalOptions="Start" Padding="8">
                    <Label x:Name="WeatherIcon" FontSize="24" HorizontalOptions="End"
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label x:Name="WeatherTemp" FontSize="14" HorizontalOptions="End"
                           TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="16" VerticalOptions="Center"
                                     HorizontalOptions="Center" WidthRequest="320">
                    <Label x:Name="ClockLabel" FontSize="44" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="White"/>
                    <Label x:Name="DateLabel" FontSize="15" HorizontalOptions="Center"
                           Opacity="0.7" TextColor="White"/>
                    <Border StrokeShape="RoundRectangle 22" StrokeThickness="0"
                            BackgroundColor="#33000000" Padding="4,0" Margin="0,8,0,0">
                        <Entry x:Name="StartSearch" Placeholder="Search Google or enter URL"
                               FontSize="14" HeightRequest="42" BackgroundColor="Transparent"
                               TextColor="White" PlaceholderColor="#AAFFFFFF"
                               ReturnType="Go" Completed="OnStartSearchGo"/>
                    </Border>
                </VerticalStackLayout>

                <CollectionView Grid.Row="2" x:Name="PinnedGrid"
                                ItemsLayout="HorizontalList" HeightRequest="76" VerticalOptions="End">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="6,0" HorizontalOptions="Center">
                                <Border StrokeShape="RoundRectangle 18" StrokeThickness="0"
                                        BackgroundColor="#33000000" WidthRequest="36" HeightRequest="36"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Initial}" FontSize="16" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="{Binding Title}" FontSize="9" TextColor="White"
                                       HorizontalOptions="Center" MaxLines="1" WidthRequest="50"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
